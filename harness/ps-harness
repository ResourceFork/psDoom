#!/usr/bin/env python3
"""ps-harness: thin launcher for psdoom_harness.py.

Put this folder on PATH, or symlink this file into a folder that is:

    ln -s "$PWD/harness/ps-harness" ~/bin/ps-harness

The link is followed back here, so the harness and its plugins are found
next to the real file. See psdoom_harness.py (or `ps-harness`) for usage.
"""

import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)

import psdoom_harness  # noqa: E402

if __name__ == "__main__":
    sys.exit(psdoom_harness.main(sys.argv[1:]))
